{
  "name": "ts-strict-utils",
  "version": "0.0.0",
  "description": "Utilities for TypeScript. Includes stricter built-ins, map that accepts objects as keys, etc...",
  "keywords": [
    "utilities",
    "strict",
    "map with object keys",
    "structural equality",
    "typescript"
  ],
  "license": "ISC",
  "author": {
    "name": "sdev-buildz",
    "email": "stevexdev@zohomail.in",
    "url": "https://github.com/sdev-buildz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdev-buildz/ts-strict-utils.git"
  },
  "bugs": {
    "url": "https://github.com/sdev-buildz/ts-strict-utils/issues"
  },
  "type": "module",
  "files": [
    "./dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "check": "turbo prettier:check lint type-check coverage:ci knip build",
    "clean": "pnx rimraf -g **/dist *.tsbuildinfo **/*.tsbuildinfo  **/generated generated .turbo coverage docs",
    "clean:all": "pnpm run clean && pnx rimraf -g **/node_modules node_modules",
    "release": "turbo build && pnpm publish",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "type-check": "tsc --build",
    "coverage:ci": "vitest --coverage --ui=false",
    "knip": "knip",
    "lint": "eslint",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "docs:user": "typedoc --options typedoc.config.js",
    "docs:dev": "typedoc --options typedoc.dev.js",
    "docs:all": "pnpm run docs:user && pnpm run docs:dev"
  },
  "dependencies": {
    "canonical-serialization": "^v1.0.0"
  },
  "peerDependencies": {
    "typescript": ">=3.5.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^11",
      "onFail": "warn"
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.3.2",
    "eslint-plugin-tsdoc": "^0.5.2",
    "globals": "^17.8.0",
    "knip": "^6.29.0",
    "prettier": "3.9.6",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "turbo": "^2.10.11",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "funding": {
    "type": "buymeacoffee",
    "url": "https://buymeacoffee.com/stevenx.dev"
  }
}
