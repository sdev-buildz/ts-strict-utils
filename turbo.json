{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "prettier:check": {},
    "lint": {},
    "build": {
      "outputs": ["./dist/**"],
      "inputs": [
        "src/**",
        "!**/dist/**",
        "**/*tsconfig*.json",
        "package.json",
        "pnpm-lock.yaml"
      ]
    },
    "type-check": {
      "outputs": ["generated/**", "src/dist/**", "tests/dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "!.github/**", "!.vscode/**", "!*.md"]
    },
    "coverage": {
      "outputs": ["./coverage/**"],
      "persistent": true,
      "inputs": ["$TURBO_DEFAULT$", "!.github/**", "!.vscode/**", "!*.md"]
    },
    "coverage:ci": {
      "outputs": ["./coverage/**"],
      "inputs": ["$TURBO_DEFAULT$", "!.github/**", "!.vscode/**", "!*.md"]
    },
    "knip": {
      "inputs": ["$TURBO_DEFAULT$", "!.github/**", "!.vscode/**", "**/*.md"]
    },
    "dev": {
      "persistent": true,
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "!.github/**", "!.vscode/**", "!*.md"]
    }
  }
}
